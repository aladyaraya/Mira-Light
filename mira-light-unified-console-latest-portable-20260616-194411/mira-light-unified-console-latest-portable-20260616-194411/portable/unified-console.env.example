# Mira Light 8790 unified console private config.
# Copy this file to portable/unified-console.env on a trusted development Mac.
# The package builder also writes a ready-to-use private env into the zip.

export MIRA_SHENZHEN_BOARD_HOST="192.168.0.183"
export MIRA_SHENZHEN_BOARD_PORT="22"
export MIRA_SHENZHEN_BOARD_USER="root"
export MIRA_SHENZHEN_BOARD_PASSWORD=""

export MIRA_UNIFIED_CONSOLE_HOST="0.0.0.0"
export MIRA_UNIFIED_OPEN_BROWSER="1"

export MIRA_CELEBRATION_CONSOLE_HOST="0.0.0.0"
export MIRA_CELEBRATION_CONSOLE_PORT="8777"
export MIRA_TOUCH_AUDIO_BRIDGE_PORT="9783"

export MIRA_SHENZHEN_REMOTE_DESKTOP_DIR="/home/sunrise/Desktop"
export MIRA_SHENZHEN_REMOTE_LED_ENABLED="1"
export MIRA_SHENZHEN_REMOTE_TOUCH_ENABLED="1"
export MIRA_BOOK_FOLLOW_SERVO_DEVICE="/dev/ttyS3"

export MIRA_UNIFIED_CAMERA_INTERVAL_SECONDS="10"
export MIRA_UNIFIED_CAMERA_START_WATCH="1"
export MIRA_UNIFIED_STOP_LEGACY_CAMERA_CONSOLE="1"

export MIRA_BOOK_FOLLOW_BASE_URL="tcp://${MIRA_SHENZHEN_BOARD_HOST}:9527"
export MIRA_BOOK_FOLLOW_RECEIVER_PORT="18000"
export MIRA_BOOK_FOLLOW_BOOTSTRAP_BOARD="0"
export MIRA_BOOK_FOLLOW_AUTO_START="0"
export MIRA_BOOK_FOLLOW_RESTART_ON_START="1"

export MIRA_SHENZHEN_SSH_CONTROL_PERSIST_SECONDS="600"
export MIRA_SHENZHEN_SSH_CONNECT_RETRIES="2"
export MIRA_SHENZHEN_SSH_RETRY_DELAY_SECONDS="0.15"

# Optional: required only by real anime/photo rendering paths.
# export ARK_API_KEY="replace-with-your-private-key"

# Optional: keep empty unless you need to override the auto-detected LAN IP.
# export MIRA_LAN_HOST="192.168.0.xxx"
