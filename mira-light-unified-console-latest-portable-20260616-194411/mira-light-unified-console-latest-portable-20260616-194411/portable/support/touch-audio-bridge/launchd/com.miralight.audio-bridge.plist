<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  launchd 自启 unit (可选)。
  装到 ~/Library/LaunchAgents/com.miralight.audio-bridge.plist 后：
    launchctl load   ~/Library/LaunchAgents/com.miralight.audio-bridge.plist   (启)
    launchctl unload ~/Library/LaunchAgents/com.miralight.audio-bridge.plist   (停)
    launchctl list | grep miralight                                            (查状态)

  注意：把下面 WorkingDirectory 和 ProgramArguments 里的路径改成你 Mac 上的实际路径！
-->
<dict>
    <key>Label</key>
    <string>com.miralight.audio-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-u</string>
        <string>/Users/YOUR_USERNAME/Downloads/GitHub/Mira Light/Mira-3/mira-light-touch-system/audio-bridge/audio_bridge_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/Downloads/GitHub/Mira Light/Mira-3/mira-light-touch-system/audio-bridge</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/mira-audio-bridge.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mira-audio-bridge.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
