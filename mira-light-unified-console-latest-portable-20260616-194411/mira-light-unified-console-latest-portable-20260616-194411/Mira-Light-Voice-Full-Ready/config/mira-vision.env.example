# Mira Light Multimodal Vision Understanding configuration.
# Copy relevant lines into your active .env file.

# ── Core settings ──
# API key. Reuses the existing ARK_API_KEY (Volces/豆包) by default.
# You already have this key from the Chrome-Camera-Anime image generation pipeline.
ARK_API_KEY=

# Or set a dedicated vision key:
MIRA_VISION_API_KEY=

# ── VLM endpoint and model ──
# Default: Volces Ark (Doubao Vision) — same platform you already use for Seedream.
# OpenAI-compatible chat completions API.
MIRA_VISION_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
MIRA_VISION_MODEL=doubao-1.5-vision-pro-32k

# ── Alternative: StepFun step-1v (you already have STEPFUN_API_KEY) ──
# MIRA_VISION_ENDPOINT=https://api.stepfun.com/v1/chat/completions
# MIRA_VISION_MODEL=step-1v-32k

# ── Alternative: Alibaba Qwen-VL (needs DASHSCOPE_API_KEY) ──
# MIRA_VISION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# MIRA_VISION_MODEL=qwen-vl-max

# ── Alternative: OpenAI GPT-4o (if accessible) ──
# MIRA_VISION_ENDPOINT=https://api.openai.com/v1/chat/completions
# MIRA_VISION_MODEL=gpt-4o

# ── Performance / cost control ──
# How often to send a frame to the VLM (seconds). Lower = more responsive but costlier.
# Recommended: 2.0-5.0 for continuous monitoring, 5.0-10.0 for cost saving.
MIRA_VISION_INTERVAL_SECONDS=3.0

# Resize frames before upload to control API token cost (pixels, width).
# 768px is a good balance. Lower to 512 for cheaper runs.
MIRA_VISION_MAX_IMAGE_WIDTH=768

# Per-request timeout (seconds).
MIRA_VISION_TIMEOUT_SECONDS=20

# Master switch. Set to 0 to disable vision understanding entirely.
MIRA_VISION_ENABLED=1
