# Mira Light Windows voice + StepFun configuration example.
# Do not commit a real API key.

# Required for real cloud calls. Leave empty for dry-run checks.
STEPFUN_API_KEY=

# Optional. The ASR client also accepts STEP_API_KEY for compatibility.
STEP_API_KEY=

# Optional. This Windows machine currently reaches StepFun through the local SOCKS proxy.
STEPFUN_PROXY_URL=

# Windows microphone. Use "default" for system default, or a device index/name.
MIRA_LIGHT_WINDOWS_MIC_DEVICE=default
MIRA_LIGHT_CAPTURE_MODE=fixed
MIRA_LIGHT_SAMPLE_RATE=16000

# StepFun file ASR fallback.
STEPFUN_ASR_ENDPOINT=https://api.stepfun.com/v1/audio/asr/sse
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_ASR_LANGUAGE=zh
STEPFUN_ASR_TIMEOUT_SECONDS=120

# StepFun realtime voice model.
STEPFUN_REALTIME_ENDPOINT=wss://api.stepfun.com/v1/realtime
STEPFUN_REALTIME_MODEL=stepaudio-2.5-realtime
STEPFUN_REALTIME_VOICE=wenrounansheng
STEPFUN_REALTIME_CHUNK_MS=100
STEPFUN_REALTIME_INPUT_SAMPLE_RATE=24000
STEPFUN_REALTIME_OUTPUT_SAMPLE_RATE=24000
STEPFUN_REALTIME_MIC_CHUNK_MS=40
STEPFUN_REALTIME_TIMEOUT_SECONDS=120

# OpenAI-compatible LLM planner. Realtime voice still uses StepFun above.
MIRA_LIGHT_PLANNER_PROVIDER=stepfun
MIRA_LIGHT_PLANNER_ENDPOINT=https://api.stepfun.com/v1/chat/completions
MIRA_LIGHT_PLANNER_MODEL=step-3.7-flash
MIRA_LIGHT_PLANNER_TIMEOUT_SECONDS=90
MIRA_LIGHT_RUNTIME_MEMORY_FILE=runtime/mira-live-memory.json
MIRA_LIGHT_RUNTIME_MEMORY_TURNS=12
# Optional DeepSeek planner override.
# MIRA_LIGHT_PLANNER_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# MIRA_LIGHT_PLANNER_ENDPOINT=https://api.deepseek.com/chat/completions
# MIRA_LIGHT_PLANNER_MODEL=deepseek-v4-flash
# Optional: let the local Hermes agent own Mira's speech/action plan.
# MIRA_LIGHT_PLANNER_PROVIDER=hermes
# MIRA_LIGHT_PLANNER_ENDPOINT=
# MIRA_LIGHT_PLANNER_MODEL=hermes-agent
# MIRA_LIGHT_HERMES_HOME=../../tools/hermes-mira-home
# MIRA_LIGHT_HERMES_EXE=../../tools/hermes-agent/.venv/Scripts/hermes.exe
# MIRA_LIGHT_PLANNER_OWNS_REPLY=1

# Optional StepFun planner fallback.
STEPFUN_LLM_ENDPOINT=https://api.stepfun.com/v1/chat/completions
STEPFUN_LLM_MODEL=step-3.7-flash
STEPFUN_LLM_TIMEOUT_SECONDS=90

# Extra hotwords are merged with the built-in Mira/Mary hotwords.
MIRA_LIGHT_ASR_HOTWORDS=Mary,米拉,Mira Light,暖光,陪伴,动作库,语音交互

# Mira Light editable prompt files. Keep long prompt text in markdown files.
MIRA_LIGHT_LLM_SYSTEM_PROMPT_FILE=config/prompts/stepfun_llm_system_prompt.md
MIRA_LIGHT_REALTIME_SYSTEM_PROMPT_FILE=config/prompts/stepfun_llm_system_prompt.md
MIRA_LIGHT_PLANNER_SYSTEM_PROMPT_FILE=config/prompts/stepfun_planner_system_prompt.md
MIRA_LIGHT_STT_INITIAL_PROMPT_FILE=config/prompts/stt_initial_prompt.md

# Board target used by the Windows action bridge.
MIRA_LIGHT_LAMP_BASE_URL=tcp://192.168.0.183:9527
