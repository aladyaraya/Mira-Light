# Mira Hermes profile environment.
# Copy to .env only if you really want local dotenv-style setup.
# Do not commit real keys.

# Hermes custom OpenAI-compatible provider reads OPENAI_API_KEY.
# The launcher can also map STEPFUN_API_KEY to OPENAI_API_KEY in memory.
OPENAI_API_KEY=

# Optional source key used by Start-Mira-Hermes-Agent.ps1.
STEPFUN_API_KEY=

